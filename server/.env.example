# Conexion a MySQL (creada en el hPanel de Hostinger según la hoja "Despliegue")
DATABASE_URL="mysql://usuario:password@localhost:3306/jomalash"

# Servidor
PORT=4000
NODE_ENV=development

# URL del frontend (React) permitida por CORS, con credenciales (cookie httpOnly)
CLIENT_URL="http://localhost:5173"

# URL pública de la app, usada para armar el enlace de recuperación de contraseña
APP_URL="http://localhost:5173"

# JWT (sesión vía cookie httpOnly, según hoja "Stack Tecnologico")
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Recuperación de contraseña (RF-02 / RNF-04: enlace de un solo uso que expira)
RESET_TOKEN_EXPIRES_MIN=30

# SMTP para el envío del correo de recuperación
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="no-responder@jomalash.com"
SMTP_PASS="password-del-correo"
SMTP_FROM="Jomalash <no-responder@jomalash.com>"

# Datos del usuario admin creado por el seed inicial (prisma/seed.js)
SEED_ADMIN_NOMBRE="Camila Caballero"
SEED_ADMIN_EMAIL="camila@jomalash.com"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
